{
	"name": "kie-frontend-electron",
	"version": "1.0.0",
	"description": "KIE Music - Electron App for interacting with kie.ai APIs",
	"author": "Mister Track <track@music.music>",
	"main": "electron/main.js",
	"private": true,
	"type": "module",
	"scripts": {
		"rebuild:node": "npm rebuild better-sqlite3",
		"rebuild:electron": "node scripts/rebuild-electron.js",
		"rebuild:e": "npm run build:electron && npm run rebuild:node",
		"dev": "npm run rebuild:node && vite dev",
		"dev:electron": "npm run build && npm run rebuild:electron && electron .",
		"build": "vite build",
		"build:electron": "npm run build && npm run rebuild:electron && electron-builder",
		"preview": "npm run build && npm run rebuild:node && node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"postinstall": "npm run rebuild:node"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"d3": "^7.9.0"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.2.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.2",
		"electron": "^44.4.5",
		"electron-builder": "^26.15.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^5.0.2"
	},
	"build": {
		"appId": "com.kie.music",
		"productName": "KIE Music",
		"npmRebuild": false,
		"directories": {
			"output": "dist-electron",
			"buildResources": "build-resources"
		},
		"files": [
			"build/**/*",
			"electron/**/*",
			"node_modules/**/*",
			"package.json"
		],
		"asarUnpack": [
			"node_modules/better-sqlite3/**/*",
			"node_modules/bindings/**/*",
			"node_modules/prebuild-install/**/*",
			"node_modules/file-uri-to-path/**/*"
		],
		"extraResources": [
			{
				"from": "build",
				"to": "app/build"
			},
			{
				"from": "build-resources/icon.png",
				"to": "icon.png"
			}
		],
		"icon": "build-resources/icon",
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Audio",
			"icon": "build-resources/icon.png"
		},
		"mac": {
			"target": [
				"zip"
			],
			"category": "public.app-category.music",
			"icon": "build-resources/icon.png"
		},
		"win": {
			"target": [
				"nsis",
				"portable"
			],
			"icon": "build-resources/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
